# ==============================================================================
# DRIFTLINE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust variables for local development or Docker deployment.
# ==============================================================================

# Database Connection (Async SQLAlchemy + asyncpg)
# Default for Docker Compose stack:
DATABASE_URL=postgresql+asyncpg://driftline:driftline@db:5432/driftline_db
# Default for local host python (outside Docker Compose):
# DATABASE_URL=postgresql+asyncpg://driftline:driftline@localhost:5433/driftline_db

# Backend API Port
PORT=8000

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication (JWT)
SECRET_KEY=driftline_super_secret_dev_key_only
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PDF Digest Output Storage Directory
# Must match volume mount in docker-compose.yml for persistent storage across container restarts
DIGEST_STORAGE_DIR=/app/storage/digests

# SMTP Mail Server Configuration (Optional - Email alerts log warnings & skip gracefully if unconfigured)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@driftline.io
DEFAULT_ALERT_EMAIL=admin@driftline.io

# OpenTelemetry
ENABLE_TELEMETRY=true
# OTLP_ENDPOINT=http://jaeger:4317

# Next.js Frontend Configuration (Passed as build-arg NEXT_PUBLIC_API_URL to container)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Pool Settings (SQLAlchemy)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Secure Cookies (Set to true in production)
COOKIE_SECURE=false
